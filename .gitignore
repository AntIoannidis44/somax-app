# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*
# Cloudflare's build (separate from local dev) needs these two Vite vars
# baked in at build time, and both are meant to be public anyway - the
# anon/publishable key has no privileges beyond what Row Level Security
# grants, unlike the other secrets in .env (API tokens, service_role key).
!.env.production

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# iOS (Capacitor) - the ios/ native project itself is committed, but not
# the CocoaPods checkout or per-machine Xcode user state
ios/App/Pods
ios/App/build
ios/App/App/public
ios/**/xcuserdata
ios/**/*.xcuserstate
ios/DerivedData

# AIS recipes (CC BY-NC-ND) - held, local only, not redistributed. See scripts/program-library/RELEASE-CHECKS.md
scripts/program-library/meals/held/ais-sports-nutrition-meals.json
scripts/program-library/tools/ais_recipes_parsed.json
scripts/program-library/tools/parse_ais_recipes.py
scripts/program-library/tools/gen_sports_nutrition_meals.py
